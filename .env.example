# Copy to .env. Everything else (models, budgets, names) lives in the settings table and is
# edited from the web UI or via PATCH /api/settings.
JARVIS_HOME=./data
JARVIS_HOST=127.0.0.1
JARVIS_PORT=9020
# Leave empty for an open local instance; set it before exposing the port.
JARVIS_TOKEN=
JARVIS_LOG_LEVEL=INFO
JARVIS_MAX_RUNS=3
